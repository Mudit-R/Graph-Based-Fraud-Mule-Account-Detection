FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements-case-review.txt .
RUN pip install --no-cache-dir -r requirements-case-review.txt \
    && mkdir /app/case-data \
    && chown 10001:10001 /app/case-data
COPY src/__init__.py src/__init__.py
COPY src/api/__init__.py src/api/case_review.py src/api/case_store.py src/api/case_neo4j.py src/api/
COPY src/graph/__init__.py src/graph/ring_detector.py src/graph/
COPY src/api/analyst/ src/api/analyst/
COPY examples/case-review-batch.json examples/case-review-batch.json
COPY examples/cross-case-review-batches.json examples/cross-case-review-batches.json
USER 10001:10001
EXPOSE 8001
CMD ["uvicorn", "src.api.case_review:create_app_from_env", "--factory", "--host", "0.0.0.0", "--port", "8001"]
